rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A trusted operator or role-management function writes roles/{uid}.
    // Legacy and browser-created inventories use users/{uid}/{kind}/{id}.
    // Native records, linked devices and activity are owned by their UID
    // and are only written by the validated pairing and workspace functions.
    function verifiedOwner(uid) {
      return request.auth != null && request.auth.uid == uid &&
        request.auth.token.email_verified == true;
    }
    function validManualRecord(kind) {
      let row = request.resource.data;
      return row.keys().hasAll(['name', 'location', 'notes', 'kind', 'updatedAt']) &&
        row.keys().hasOnly(['name', 'location', 'notes', 'kind', 'updatedAt', 'projectId', 'deviceId']) &&
        row.name is string && row.name.size() > 0 && row.name.size() <= 120 &&
        row.location is string && row.location.size() <= 1000 &&
        row.notes is string && row.notes.size() <= 4000 &&
        row.kind == kind && row.updatedAt == request.time &&
        (!('projectId' in row) || (kind == 'backups' && row.projectId is string && row.projectId.size() <= 150)) &&
        (!('deviceId' in row) || (kind == 'backups' && row.deviceId is string && row.deviceId.size() <= 150));
    }
    match /roles/{uid} {
      allow get: if verifiedOwner(uid);
    }
    match /users/{uid}/{kind}/{id} {
      allow read: if verifiedOwner(uid) && kind in [
        'projects', 'devices', 'backups', 'nativeProjects', 'linkedDevices', 'nativeBackups', 'activity'
      ];
      allow delete: if verifiedOwner(uid) && kind in ['projects', 'devices', 'backups'];
      allow create, update: if verifiedOwner(uid) && kind in ['projects', 'devices', 'backups'] && validManualRecord(kind);
    }
  }
}
